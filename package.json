{
  "name": "@findbycolor/camera",
  "version": "1.0.0",
  "description": "Find By Color API",
  "author": "Find By Color",
  "main": "gulpfile.js",
  "license": "UNLICENSED",
  "private": true,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "contributors": [
    {
      "name": "Peter Schmalfeldt",
      "email": "peter@findbycolor.com",
      "url": "https://findbycolor.com"
    }
  ],
  "engines": {
    "node": ">= 18.15.0",
    "npm": ">= 9.5.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development && gulp",
    "build:production": "cross-env NODE_ENV=production && gulp build && gulp sitemap && npm run -s test",
    "build:staging": "cross-env NODE_ENV=staging && gulp build && npm run -s test",
    "build:dev": "cross-env NODE_ENV=development && gulp build && npm run -s test",
    "test": "npm run -s lint:js && npm run -s lint:html",
    "lint:js": "eslint --ext .js src --fix && echo '\n【ツ】JAVASCRIPT PERFECTION !!!\n'",
    "lint:html": "gulp lint-html && echo '\n【ツ】HTML PERFECTION !!!\n'",
    "help": "node node_modules/npm-scripts-help"
  },
  "devDependencies": {
    "ansi-colors": "^4.1.3",
    "babel-cli": "^6.26.0",
    "babel-preset-env": "^1.7.0",
    "browser-sync": "^2.29.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.44.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-standard": "^5.0.0",
    "fancy-log": "^2.0.0",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-csso": "^4.0.1",
    "gulp-htmllint": "0.0.19",
    "gulp-htmlmin": "^5.0.1",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^5.1.0",
    "gulp-sitemap": "^8.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "mobile-detect": "^1.4.5",
    "node-sass": "^9.0.0",
    "npm-scripts-help": "^0.8.0",
    "rimraf": "^5.0.1",
    "workbox-build": "^7.0.0"
  }
}
